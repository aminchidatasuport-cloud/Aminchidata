# ──────────────────────────────────────────────────────────
# AminchiData – Environment Variables
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# ──────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────
APP_URL=http://localhost:8000
APP_DEBUG=false

# ── Database ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aminchidata
DB_USER=root
DB_PASS=

# ── Paystack Payment Gateway ────────────────────────────
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# ── Flutterwave Payment Gateway ─────────────────────────
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=

# ── AlrahuzData VTU Provider ────────────────────────────
# API docs: https://alrahuzdata.com.ng/documentation/
ALRAHUZDATA_BASE_URL=https://alrahuzdata.com.ng
ALRAHUZDATA_API_TOKEN=
